# Envoi d'email (devis/factures) via Gmail SMTP.
# 1. Active la validation en 2 étapes sur le compte Gmail à utiliser
# 2. Génère un "mot de passe d'application" : https://myaccount.google.com/apppasswords
# 3. Renseigne les valeurs ci-dessous dans un fichier .env (copie ce fichier vers .env)
SMTP_USER=
SMTP_APP_PASSWORD=

PORT=3001

# URL publique de l'app, utilisée dans les liens des emails de relance
# automatique de factures impayées (le cron n'a pas de requête HTTP pour la
# déduire tout seul). Mets l'adresse réelle utilisée pour accéder à l'app
# (IP du réseau local, nom de domaine...).
PUBLIC_URL=http://localhost:5173

# Paiement en ligne (bouton "Encaisser" sur les factures) via Stripe Checkout.
# 1. Récupère ta clé secrète sur https://dashboard.stripe.com/apikeys
#    (commence par sk_test_... en mode test, sk_live_... en production)
# 2. Crée un endpoint webhook sur https://dashboard.stripe.com/webhooks
#    pointant vers PUBLIC_URL/api/stripe/webhook, événement
#    "checkout.session.completed", puis copie sa clé de signature (whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notifications push (voir VAPID.local.md pour générer une paire de clés :
# npx web-push generate-vapid-keys). Sans ces deux valeurs, l'app tourne
# normalement mais aucune notification push n'est envoyée.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Variables lues par server/env.mjs (server/.env en local, à définir via le
# tableau de bord de l'hébergeur en production — jamais commité, voir
# .gitignore).

# Port d'écoute du serveur (Railway le définit automatiquement).
PORT=3001

# Domaine public de l'app (utilisé dans les liens des emails — vérification,
# réinitialisation de mot de passe…). En local : http://localhost:5173
PUBLIC_URL=

# Envoi d'email (compte Gmail + mot de passe d'application, voir la doc
# Google "mots de passe des applications").
SMTP_USER=
SMTP_APP_PASSWORD=

# Paiements en ligne (clé secrète du compte Stripe + secret de signature du
# webhook configuré sur PUBLIC_URL/api/stripe/webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notifications push (paire de clés VAPID — générées une fois avec
# `npx web-push generate-vapid-keys`, jamais régénérées ensuite sous peine
# d'invalider les abonnements déjà enregistrés).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# En production sur un disque éphémère (ex. Railway sans volume), la base et
# les fichiers uploadés seraient perdus à chaque redéploiement — ces trois
# variables les redirigent vers un disque persistant. Laisser vide en local
# (valeurs par défaut à côté du code, inchangées).
DB_PATH=
UPLOADS_DIR=
BACKUP_DIR=

# Lu par le FRONTEND (build Vite) — clé publique VAPID, doit correspondre à
# VAPID_PUBLIC_KEY ci-dessus.
VITE_VAPID_PUBLIC_KEY=
